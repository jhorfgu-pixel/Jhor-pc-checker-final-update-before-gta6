  foreach ($kf in @(Get-ChildItem -LiteralPath $kr -Recurse -Depth 3 -File -Force -ErrorAction SilentlyContinue | Where-Object { $_.Extension -match '(?i)^\.(exe|dll|zip|rar|7z|msi|bat|lnk|scr|jar)$' } | Select-Object -First 3000)) {
