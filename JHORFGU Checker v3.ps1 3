$offReady = $null
function Get-OffReady {
  if ($null -eq $script:offReady) {
    $script:offReady = $false
    try { if (-not ('JhOffHive' -as [type])) { Add-Type -TypeDefinition $offSrc -ErrorAction Stop }; $script:offReady = $true } catch {}
  }
  $script:offReady
}
function Open-OffHive($file, $secs) {
  if (-not (Get-OffReady)) { return $null }
  $ex = $false; try { $ex = [IO.File]::Exists($file) } catch {}
  if (-not $ex) { return $null }
  try { [JhOffHive]::Deadline = [DateTime]::UtcNow.AddSeconds($secs) } catch {}
  try { return [JhOffHive]::Open($file) } catch { return $null }
}
function Read-UserHives($userDir, $userName, $lbl, $suffix, $what) {
  $cnt = 0; $tried = 1; $opened = 0
  $h = Open-OffHive (Join-Path $userDir 'NTUSER.DAT') 3
  if ($h) {
    $opened++
    try {
      $ua = $h.Root.OpenSubKey('Software\Microsoft\Windows\CurrentVersion\Explorer\UserAssist')
      if ($ua) {
        foreach ($g in @($ua.GetSubKeys())) {
          $ck = $g.OpenSubKey('Count'); if (-not $ck) { continue }
          foreach ($vn in @($ck.GetValueNames())) {
            $dec = Rot13 $vn
            $nn = Match-Leaf (Leaf-Of $dec) $false
            if (-not $nn) { continue }
            $bb = $ck.GetValue($vn); $lastO = $null; $runsO = $null
            if ($bb -is [byte[]] -and $bb.Length -ge 68) { $ftO = [BitConverter]::ToInt64($bb, 60); if ($ftO -gt 0) { try { $lastO = [datetime]::FromFileTime($ftO) } catch {} }; $runsO = [BitConverter]::ToInt32($bb, 4) }
            $cnt++
            Add-Ev @{ Name=$nn; Src="UserAssist ($suffix)"; Path=$null; PIE=$true; Run=$lastO; RunKind="last run ($suffix)"; Runs=$runsO; Note="run history of $what ($lbl, user $userName): $dec" }
          }
        }
      }
      $rm = $h.Root.OpenSubKey('Software\Microsoft\Windows\CurrentVersion\Explorer\RunMRU')
      if ($rm) {
        foreach ($vn in @($rm.GetValueNames())) {
          $rv = "$($rm.GetValue($vn))"
          if ($rv -and (Test-Hit $rv)) { $nn = Find-NameToken $rv; if ($nn) { $cnt++; Add-Ev @{ Name=$nn; Src="RunMRU ($suffix)"; Path=$null; PIE=$true; Note="typed in the Run box on $what ($lbl, user $userName): $rv" } } }
        }
      }
    } catch {}
    $h.Dispose()
  }
  $tried++
  $h = Open-OffHive (Join-Path $userDir 'AppData\Local\Microsoft\Windows\UsrClass.dat') 3
  if ($h) {
    $opened++
    try {
      $mc = $h.Root.OpenSubKey('Local Settings\Software\Microsoft\Windows\Shell\MuiCache')
      if ($mc) {
        foreach ($vn in @($mc.GetValueNames())) {
          if (-not (Test-Hit $vn)) { continue }
          $pp = $vn -replace '\.(FriendlyAppName|ApplicationCompany)$', ''
          $nn = Match-Leaf (Leaf-Of $pp) $false
          if ($nn) { $cnt++; Add-Ev @{ Name=$nn; Src="MUICache ($suffix)"; Path=$null; PIE=$true; Note="$what ($lbl, user $userName) remembers a program it ran: $pp" } }
        }
      }
    } catch {}
    $h.Dispose()
  }
  [pscustomobject]@{ Count = $cnt; Tried = $tried; Opened = $opened }
}
function Read-OldInstall($inst, $capSec) {
  $root = $inst.Root; $lbl = $inst.Label; $cnt = 0; $tried = 0; $opened = 0
  $sw2 = [Diagnostics.Stopwatch]::StartNew()
  # --- old user accounts: run history (NTUSER.DAT) + MUICache (UsrClass.dat) ---
  foreach ($ud in @(Get-ChildItem -LiteralPath "$root\Users" -Directory -Force -ErrorAction SilentlyContinue)) {
    if ($sw2.Elapsed.TotalSeconds -gt $capSec) { break }
