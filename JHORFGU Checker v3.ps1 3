            foreach ($bk in @($bam.GetSubKeys())) {
              foreach ($vn in @($bk.GetValueNames())) {
                if (-not (Test-Hit $vn)) { continue }
                $n = Match-Leaf (Leaf-Of $vn) $false
                if (-not $n) { continue }
                $bv = $bk.GetValue($vn); $bt = $null
