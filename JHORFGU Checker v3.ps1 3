  foreach ($ac in @($otherProfiles | Where-Object { $_.Kind -eq 'Account' })) {
    $out.Add("   - $($ac.Name): " + $(if ($ac.Readable) { 'folders readable' } else { 'folders blocked' }) + $(if ($ac.LastUse) { "; last used $($ac.LastUse.ToString('yyyy-MM-dd HH:mm'))" } else { '' }) + $(if ($ac.Loaded) { '; logged in right now' } else { '' }))
  }
  if ($acctTried -gt 0) { $out.Add("   Registry run history of these accounts: $acctOpened of $acctTried file(s) could be read, $acctCnt record(s) matched a known name.") }
  if ($lockedProfiles.Count -gt 0) {
