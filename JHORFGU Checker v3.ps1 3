          if ($dn -ieq 'autoexec') { $res.Add("A|$d") }
          if (Match-Leaf $dn $true) { $res.Add("D|$d") }
          $q.Enqueue(@($d, ($depth - 1)))
        }
      } catch {}
    }
  }
