  $p = "$($x.Path)".TrimEnd('\'); $nn = $null
  if ($pathName.ContainsKey($p.ToLower())) { $nn = $pathName[$p.ToLower()] }
  else {
    # Only the immediate parent and grandparent are checked, and ONLY against $dirName: a folder that was
    # itself recorded as a tool's own install / autoexec / Monaco folder. A name is never re-derived from an
    # ancestor folder's name on its own (a leftover folder such as "SacredStep (old)" sitting a few levels
    # above an unrelated AHK script used to relabel that script as SacredStep; this is why that fallback is gone).
    $q = $p
