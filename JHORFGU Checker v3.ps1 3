            if ($sc2 -is [byte[]] -and $sc2.Length -gt 64) {
              $seenP2 = New-Object 'System.Collections.Generic.HashSet[string]'
              foreach ($a in 0,1) {
                $str2 = [Text.Encoding]::Unicode.GetString($sc2, $a, (($sc2.Length - $a) -band -2))
                foreach ($m in [regex]::Matches($str2, '(?i)[A-Z]:\\[^\x00-\x1f"<>|*?]{2,260}?\.(?:exe|dll|bat|cmd|ps1|scr|msi)')) {
