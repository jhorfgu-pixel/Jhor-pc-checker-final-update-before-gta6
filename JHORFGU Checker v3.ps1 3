Set-Stage 'Checking antivirus and driver-protection settings'
# ---------- v2.7: security settings that cheats usually need switched off (leads only: there are normal reasons for each) ----------
$hardenLeads = New-Object System.Collections.Generic.List[string]
try {
  $mps = Get-MpComputerStatus -ErrorAction Stop
  if ($mps) {
    if ($mps.AntivirusEnabled -eq $false) { $hardenLeads.Add('   - Windows Defender antivirus is disabled (normal if another antivirus is installed; executors usually need it off).') }
    elseif ($mps.RealTimeProtectionEnabled -eq $false) { $hardenLeads.Add('   - Defender real-time protection is OFF (normal if another antivirus is installed; executors usually need it off).') }
    if ($mps.IsTamperProtected -eq $false) { $hardenLeads.Add('   - Defender tamper protection is OFF.') }
  }
} catch {}
foreach ($pol in @(@('HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender','DisableAntiSpyware'), @('HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection','DisableRealtimeMonitoring'))) {
  try { $pv = (Get-ItemProperty -LiteralPath $pol[0] -ErrorAction Stop).($pol[1]); if ($pv -eq 1) { $hardenLeads.Add("   - A policy turns Defender protection off ($($pol[1]) = 1 in $($pol[0])).") } } catch {}
}
try { if ((Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config' -ErrorAction Stop).VulnerableDriverBlocklistEnable -eq 0) { $hardenLeads.Add('   - The Microsoft vulnerable-driver blocklist is turned OFF (this lets the drivers cheats use to reach memory load).') } } catch {}
try { if ((Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity' -ErrorAction Stop).Enabled -eq 0) { $hardenLeads.Add('   - Memory integrity (HVCI) is explicitly turned OFF.') } } catch {}

Set-Stage 'Looking for hidden folders and hidden data streams'
# ---------- v2.7: hiding places ----------
$hideLeads = New-Object System.Collections.Generic.List[string]
$hRoots = New-Object System.Collections.Generic.List[string]
foreach ($hr0 in @("$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop","$env:USERPROFILE\Documents",$env:PUBLIC,$env:ProgramData)) { if ($hr0 -and (Test-Path -LiteralPath $hr0)) { $hRoots.Add($hr0) } }
foreach ($v in $volMap.Values) { if (($v.DriveType -eq 2 -or $v.DriveType -eq 3) -and $v.Letter -ne $sysLetter) { $hRoots.Add("$($v.Letter):\") } }
$hDeadline = (Get-Date).AddSeconds(2.5)
foreach ($hr in $hRoots) {
  if ((Get-Date) -gt $hDeadline -or $hideLeads.Count -ge 8) { break }
  foreach ($hd in @(Get-ChildItem -LiteralPath $hr -Directory -Force -Recurse -Depth 1 -ErrorAction SilentlyContinue | Where-Object { (($_.Attributes -band 6) -eq 6) -and $_.Name -notmatch '^(\$Recycle\.Bin|System Volume Information|Config\.Msi|Recovery|MSOCache|Documents and Settings|WindowsApps)$' -and $_.FullName -notmatch '(?i)\\ProgramData\\(Microsoft|Package Cache|Packages|regid|SoftwareDistribution|USOShared|Application Data|Desktop|Documents|Start Menu|Templates)' } | Select-Object -First 10)) {
    if ($hideLeads.Count -ge 8) { break }
    if (Folder-HasExec $hd.FullName) { $hideLeads.Add("   - Hidden + system folder that contains programs: $($hd.FullName)") }
  }
}
# a program can also be hidden INSIDE another file (NTFS alternate data stream)
$adsCount = 0
foreach ($ar0 in @("$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop")) {
  if ((Get-Date) -gt $hDeadline.AddSeconds(1.5) -or $adsCount -ge 5) { break }
  if (-not (Test-Path -LiteralPath $ar0)) { continue }
  foreach ($af in @(Get-ChildItem -LiteralPath $ar0 -File -Force -ErrorAction SilentlyContinue | Select-Object -First 250)) {
    if ($adsCount -ge 5) { break }
    try {
      foreach ($st in @(Get-Item -LiteralPath $af.FullName -Stream * -ErrorAction Stop)) {
        if ($st.Stream -notin ':$DATA','Zone.Identifier' -and $st.Length -gt 10240) { $adsCount++; $hideLeads.Add("   - Hidden data stream '$($st.Stream)' ($([int]($st.Length / 1024)) KB) inside: $($af.FullName)") }
      }
    } catch {}
  }
}

# ---------- v2.7 (admin): NTFS change journal = names of files that were created, renamed or DELETED recently, even if nothing is left ----------
$usnInfo = ''
if ($isAdmin -and (RemainMs 1) -gt 3500) {
  Set-Stage 'Reading the NTFS change journal (created / renamed / deleted files)'
  try {
    $psi = New-Object Diagnostics.ProcessStartInfo
    $psi.FileName = 'fsutil.exe'; $psi.Arguments = "usn readjournal $($env:SystemDrive) csv"
    $psi.RedirectStandardOutput = $true; $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true
    $upr = [Diagnostics.Process]::Start($psi)
    $usnSw = [Diagnostics.Stopwatch]::StartNew(); $usnLines = 0; $usnHits = 0
    $usnSeen = New-Object 'System.Collections.Generic.HashSet[string]'
    $usnLimit = [math]::Min(5000, (RemainMs 5000))
    while ($usnSw.ElapsedMilliseconds -lt $usnLimit -and $usnHits -lt 30) {
      $ul = $upr.StandardOutput.ReadLine()
      if ($null -eq $ul) { break }
      $usnLines++
      if ($ul.Length -lt 8 -or $ul -notmatch '(?i)\.(exe|dll|zip|rar|7z|msi|bat|scr|lnk|ahk)\b') { continue }
      $ul2 = Norm-Name $ul
      if ($ul2 -notmatch $patNG -or $ul2 -match $exclude) { continue }
      $unt = Find-NameToken $ul2
      if (-not $unt -or ($genericNames -contains $unt)) { continue }
      $ufile = ''; if ($ul2 -match '(?i)([^",\\/]+\.(?:exe|dll|zip|rar|7z|msi|bat|scr|lnk|ahk))') { $ufile = $Matches[1] }
      $urs = ''; if ($ul2 -match '(?i)(file delete|rename: (?:old|new) name|file create)') { $urs = $Matches[1] }
      $utm = $null; if ($ul2 -match '(\d{1,4}[/\-.]\d{1,2}[/\-.]\d{1,4}[ T]+\d{1,2}:\d{2}(?::\d{2})?(?: ?[AaPp][Mm])?)') { $tmp = [datetime]::MinValue; if ([datetime]::TryParse($Matches[1], [ref]$tmp)) { $utm = $tmp } }
      if (-not $usnSeen.Add("$ufile|$urs")) { continue }
      $usnHits++
      Add-Ev @{ Name=$unt; Src='NTFS change journal'; Path=$null; PIE=$true; Run=$utm; RunKind='file activity (NTFS journal)'; Note=("NTFS journal: $urs  '$ufile'" + $(if ($utm) { "  at $($utm.ToString('yyyy-MM-dd HH:mm'))" } else { '' })) }
    }
    try { if (-not $upr.HasExited) { $upr.Kill() } } catch {}
    $usnInfo = "NTFS change journal: $usnLines record(s) read" + $(if ($usnHits -gt 0) { ", $usnHits matched a known name" } else { '' }) + ' (the journal only keeps recent activity, usually days).'
  } catch { $usnInfo = 'NTFS change journal could not be read.' }
}

Set-Stage 'Checking for a Windows reinstall'
# ---------- 5. Windows reinstall / history wipe check (v2.6) ----------
# A reinstall or "Reset this PC" wipes the run history that most checks depend on. These signs show whether that happened and what survived.
$osInstall = $null; $osDays = $null; $recentInstall = $false; $reinstallFlags = 0; $prevReplaced = $null; $prevInstall = $null
$reinstallNotes = New-Object System.Collections.Generic.List[string]
try {
  $cv = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -ErrorAction Stop
  if ($cv.InstallTime) { $osInstall = [datetime]::FromFileTime([int64]$cv.InstallTime) }
  elseif ($cv.InstallDate) { $osInstall = ([datetime]'1970-01-01').AddSeconds([double]$cv.InstallDate).ToLocalTime() }
} catch {}
if ($osInstall) {
  $osDays = [int]((Get-Date) - $osInstall).TotalDays
  $reinstallNotes.Add("   Windows was installed (or last reset / upgraded) on $($osInstall.ToString('yyyy-MM-dd HH:mm')), $osDays day(s) ago.")
  if ($osDays -le 60) { $recentInstall = $true; $reinstallFlags++; $reinstallNotes.Add('   -> A recent install: traces from before that date are gone from this Windows, so a clean scan counts for less.') }
}
try {
  foreach ($so in @(Get-ChildItem 'HKLM:\SYSTEM\Setup' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -like 'Source OS*' } | Select-Object -First 8)) {
    $sop = Get-ItemProperty -LiteralPath $so.PSPath -ErrorAction SilentlyContinue
    $sdt = $null; if ($sop.InstallDate) { try { $sdt = ([datetime]'1970-01-01').AddSeconds([double]$sop.InstallDate).ToLocalTime() } catch {} }
    $reinstallNotes.Add("   An earlier Windows was recorded by setup: $($sop.ProductName) build $($sop.CurrentBuild)" + $(if ($sdt) { ", installed $($sdt.ToString('yyyy-MM-dd'))" } else { '' }) + "   [$($so.PSChildName)]")
  }
} catch {}
$wOldDir = "$env:SystemDrive\Windows.old"
if (Test-Path -LiteralPath $wOldDir) {
  $reinstallFlags++
  $wi0 = Get-Item -LiteralPath $wOldDir -Force -ErrorAction SilentlyContinue
  $prevReplaced = $wi0.CreationTime
  $reinstallNotes.Add("   Windows.old exists (created $($wi0.CreationTime.ToString('yyyy-MM-dd'))): the Windows from BEFORE this one is still on disk. Its user folders are scanned" + $(if ($isAdmin) { ' and its run history is read.' } else { '; its run history is read as far as this account may open the files (the admin edition reads all of it).' }))
}
if (Test-Path -LiteralPath "$env:SystemDrive\`$SysReset") { $reinstallFlags++; $reinstallNotes.Add('   A "Reset this PC" folder ($SysReset) exists: the PC was reset.') }
$pan = "$env:windir\Panther\setupact.log"
if (Test-Path -LiteralPath $pan) { $reinstallNotes.Add("   Windows setup log last written: $((Get-Item -LiteralPath $pan).LastWriteTime.ToString('yyyy-MM-dd HH:mm'))") }
if ((RemainMs 1) -gt 0) {
  try {
    foreach ($c104 in @(Get-WinEvent -FilterHashtable @{ LogName='System'; Id=104; ProviderName='Microsoft-Windows-Eventlog' } -MaxEvents 5 -ErrorAction Stop)) {
      $reinstallFlags++; $reinstallNotes.Add("   An event log was CLEARED on $($c104.TimeCreated.ToString('yyyy-MM-dd HH:mm')) (System log, event 104). Clearing logs hides activity.")
    }
  } catch {}
}
if ($isAdmin -and (RemainMs 1) -gt 0) {
  try {
    foreach ($c1102 in @(Get-WinEvent -FilterHashtable @{ LogName='Security'; Id=1102 } -MaxEvents 5 -ErrorAction Stop)) {
      $reinstallFlags++; $reinstallNotes.Add("   The Security log was CLEARED on $($c1102.TimeCreated.ToString('yyyy-MM-dd HH:mm')) (event 1102).")
    }
  } catch {}
}
if ($osInstall -and (RemainMs 1) -gt 0) {
  try {
    $oldestEv = Get-WinEvent -LogName System -Oldest -MaxEvents 1 -ErrorAction Stop
    if ($oldestEv -and (($oldestEv.TimeCreated - $osInstall).TotalDays -gt 30)) { $reinstallNotes.Add("   The System log starts on $($oldestEv.TimeCreated.ToString('yyyy-MM-dd')), $([int](($oldestEv.TimeCreated - $osInstall).TotalDays)) days after Windows was installed: older entries were cleared or rotated out (normal on busy PCs).") }
  } catch {}
}

Set-Stage 'Reading the previous Windows (Windows.old)'
# ---------- 6. The previous Windows install (v2.8) ----------
# Windows keeps the old install in Windows.old for a while after a reset or reinstall. Its files are protected, so this needs the admin edition.
# What is read (each hive is loaded read-only for a moment, then unloaded): run history of every old user, ShimCache + BAM (SYSTEM),
# installed programs + install date (SOFTWARE), Amcache (every program that ever ran, with its path), Prefetch (run counts and times), the old System event log.
$woRoot = "$env:SystemDrive\Windows.old"
if (Test-Path -LiteralPath $woRoot) {
  if (-not $isAdmin) { $reinstallNotes.Add('   The system files of the previous Windows (Windows.old) are protected: without admin only the files this account may open are read (see the line below); the admin edition reads Prefetch, Amcache, BAM, ShimCache, installed programs and event logs too.') }
  else {
    function Load-Hive($file, $nm) {
      if (-not (Test-Path -LiteralPath $file -PathType Leaf -ErrorAction SilentlyContinue)) { return $false }
      $null = & reg.exe load "HKU\$nm" "$file" 2>&1
      return ($LASTEXITCODE -eq 0)
    }
    function Unload-Hive($nm) { [GC]::Collect(); [GC]::WaitForPendingFinalizers(); $null = & reg.exe unload "HKU\$nm" 2>&1 }
    $pwSw = [Diagnostics.Stopwatch]::StartNew()
    $pwCount = 0
    $cfg = "$woRoot\Windows\System32\config"
    # --- run history of every old user ---
    foreach ($wo in @(Get-ChildItem "$woRoot\Users" -Directory -Force -ErrorAction SilentlyContinue)) {
      if ($pwSw.Elapsed.TotalSeconds -gt 6) { break }
      if (-not (Load-Hive (Join-Path $wo.FullName 'NTUSER.DAT') 'JHORFGU_OLDU')) { continue }
      try {
        foreach ($g in @(Get-ChildItem 'Registry::HKEY_USERS\JHORFGU_OLDU\Software\Microsoft\Windows\CurrentVersion\Explorer\UserAssist' -ErrorAction SilentlyContinue)) {
          $ck = Get-Item -LiteralPath "$($g.PSPath)\Count" -ErrorAction SilentlyContinue
          if (-not $ck) { continue }
          foreach ($vn in $ck.GetValueNames()) {
            $dec = Rot13 $vn
            $nn = Match-Leaf (Leaf-Of $dec) $false
            if (-not $nn) { continue }
            $bb = $ck.GetValue($vn); $lastO = $null; $runsO = $null
            if ($bb -is [byte[]] -and $bb.Length -ge 68) { $ftO = [BitConverter]::ToInt64($bb, 60); if ($ftO -gt 0) { try { $lastO = [datetime]::FromFileTime($ftO) } catch {} }; $runsO = [BitConverter]::ToInt32($bb, 4) }
            $pwCount++
            Add-Ev @{ Name=$nn; Src='UserAssist (previous Windows)'; Path=$null; PIE=$true; Run=$lastO; RunKind='last run (previous Windows)'; Runs=$runsO; Note="run history of the PREVIOUS Windows (user $($wo.Name)): $dec" }
          }
        }
        $rm = Get-Item -LiteralPath 'Registry::HKEY_USERS\JHORFGU_OLDU\Software\Microsoft\Windows\CurrentVersion\Explorer\RunMRU' -ErrorAction SilentlyContinue
        if ($rm) { foreach ($vn in $rm.GetValueNames()) { $rv = "$($rm.GetValue($vn))"; if (Test-Hit $rv) { $nn = Find-NameToken $rv; if ($nn) { $pwCount++; Add-Ev @{ Name=$nn; Src='RunMRU (previous Windows)'; Path=$null; PIE=$true; Note="typed in the Run box on the PREVIOUS Windows (user $($wo.Name)): $rv" } } } } }
      } catch {}
      $ck = $null; $g = $null; $rm = $null; Unload-Hive 'JHORFGU_OLDU'
    }
    # --- SYSTEM hive: ShimCache + BAM ---
    $hOk = Load-Hive "$cfg\SYSTEM" 'JHORFGU_OLDSYS'
    if ($hOk -and $pwSw.Elapsed.TotalSeconds -gt 7) { Unload-Hive 'JHORFGU_OLDSYS'; $hOk = $false }
    if ($hOk) {
      try {
        $selCur = 1; try { $selCur = [int](Get-ItemProperty 'Registry::HKEY_USERS\JHORFGU_OLDSYS\Select' -ErrorAction Stop).Current } catch {}
        $cs = 'Registry::HKEY_USERS\JHORFGU_OLDSYS\ControlSet{0:D3}' -f $selCur
        try {
          $sc2 = (Get-ItemProperty "$cs\Control\Session Manager\AppCompatCache" -ErrorAction Stop).AppCompatCache
          if ($sc2 -is [byte[]] -and $sc2.Length -gt 64) {
            $seenP2 = New-Object 'System.Collections.Generic.HashSet[string]'
            foreach ($a in 0,1) {
              $str2 = [Text.Encoding]::Unicode.GetString($sc2, $a, (($sc2.Length - $a) -band -2))
              foreach ($m in [regex]::Matches($str2, '(?i)[A-Z]:\\[^\x00-\x1f"<>|*?]{2,260}?\.(?:exe|dll|bat|cmd|ps1|scr|msi)')) {
                $p2 = $m.Value
                if (-not $seenP2.Add($p2.ToLower()) -or -not (Test-Hit $p2)) { continue }
                $n = Match-Leaf (Leaf-Of $p2) $false
                if ($n) { $pwCount++; Add-Ev @{ Name=$n; Src='ShimCache (previous Windows)'; Path=$null; PIE=$true; Note="the PREVIOUS Windows remembers running: $p2" } }
              }
            }
          }
        } catch {}
        foreach ($bk in @(Get-ChildItem "$cs\Services\bam\State\UserSettings" -ErrorAction SilentlyContinue)) {
          $bkk = Get-Item -LiteralPath $bk.PSPath -ErrorAction SilentlyContinue
          if (-not $bkk) { continue }
          foreach ($vn in $bkk.GetValueNames()) {
            if (-not (Test-Hit $vn)) { continue }
            $n = Match-Leaf (Leaf-Of $vn) $false
            if (-not $n) { continue }
            $bv = $bkk.GetValue($vn); $bt = $null
            if ($bv -is [byte[]] -and $bv.Length -ge 8) { try { $bt = [datetime]::FromFileTime([BitConverter]::ToInt64($bv, 0)) } catch {} }
            $pwCount++
            Add-Ev @{ Name=$n; Src='BAM (previous Windows)'; Path=$null; PIE=$true; Run=$bt; RunKind='last run (BAM, previous Windows)'; Note="the PREVIOUS Windows recorded running: $vn" }
          }
        }
      } catch {}
      $bkk = $null; $bk = $null; Unload-Hive 'JHORFGU_OLDSYS'
    }
    # --- SOFTWARE hive: install date + installed programs ---
    $hOk = Load-Hive "$cfg\SOFTWARE" 'JHORFGU_OLDSW'
    if ($hOk -and $pwSw.Elapsed.TotalSeconds -gt 8) { Unload-Hive 'JHORFGU_OLDSW'; $hOk = $false }
    if ($hOk) {
      try {
        $pcv = Get-ItemProperty 'Registry::HKEY_USERS\JHORFGU_OLDSW\Microsoft\Windows NT\CurrentVersion' -ErrorAction SilentlyContinue
        if ($pcv.InstallTime) { try { $prevInstall = [datetime]::FromFileTime([int64]$pcv.InstallTime) } catch {} }
        elseif ($pcv.InstallDate) { try { $prevInstall = ([datetime]'1970-01-01').AddSeconds([double]$pcv.InstallDate).ToLocalTime() } catch {} }
        foreach ($ub in 'Microsoft\Windows\CurrentVersion\Uninstall','WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall') {
          foreach ($uk in @(Get-ChildItem "Registry::HKEY_USERS\JHORFGU_OLDSW\$ub" -ErrorAction SilentlyContinue)) {
            $upp = Get-ItemProperty -LiteralPath $uk.PSPath -ErrorAction SilentlyContinue
            if ($upp.DisplayName -and (Test-Hit $upp.DisplayName)) {
              $n = Match-Leaf "$($upp.DisplayName)" $true
              if ($n) { $pwCount++; Add-Ev @{ Name=$n; Src='Uninstall list (previous Windows)'; Path=$null; PIE=$true; Note="installed on the PREVIOUS Windows: '$($upp.DisplayName)'" } }
            }
          }
        }
      } catch {}
      $uk = $null; Unload-Hive 'JHORFGU_OLDSW'
    }
    # --- Amcache: every program that ever ran on the old Windows, with its path ---
    $hOk = Load-Hive "$woRoot\Windows\appcompat\Programs\Amcache.hve" 'JHORFGU_OLDAM'
    if ($hOk -and $pwSw.Elapsed.TotalSeconds -gt 9) { Unload-Hive 'JHORFGU_OLDAM'; $hOk = $false }
    if ($hOk) {
      try {
        foreach ($ak in @(Get-ChildItem 'Registry::HKEY_USERS\JHORFGU_OLDAM\Root\InventoryApplicationFile' -ErrorAction SilentlyContinue)) {
          if ($pwSw.Elapsed.TotalSeconds -gt 11) { break }
          $ap = Get-ItemProperty -LiteralPath $ak.PSPath -ErrorAction SilentlyContinue
          $apath = "$($ap.LowerCaseLongPath)"
          if (-not $apath) { continue }
          $n = Match-Leaf (Leaf-Of $apath) $false
          if (-not $n -and "$($ap.Name)") { $n = Match-Leaf "$($ap.Name)" $false }
          if ($n) { $pwCount++; Add-Ev @{ Name=$n; Src='Amcache (previous Windows)'; Path=$null; PIE=$true; Note="Amcache of the PREVIOUS Windows lists the program: $apath" + $(if ($ap.FileId) { "  (SHA1 $("$($ap.FileId)".TrimStart('0')))" } else { '' }) } }
        }
      } catch {}
      $ak = $null; Unload-Hive 'JHORFGU_OLDAM'
    }
    # --- Prefetch of the old Windows: run counts and times ---
    foreach ($pf in @(Get-ChildItem "$woRoot\Windows\Prefetch" -Filter *.pf -File -Force -ErrorAction SilentlyContinue | Where-Object { Test-Hit $_.Name })) {
      $n = Match-Leaf $pf.Name $false
      if (-not $n) { continue }
      $pi = Get-PrefetchInfo $pf.FullName
      $lastRun = $pf.LastWriteTime; if ($pi -and $pi.Times.Count -gt 0) { $lastRun = $pi.Times[0] }
      $pwCount++
      Add-Ev @{ Name=$n; Src='Prefetch (previous Windows)'; Path=$null; Run=$lastRun; RunKind='last run (Prefetch, previous Windows)'; Created=$pf.CreationTime
                PfRuns=$(if ($pi) { $pi.Runs } else { $null }); RunList=$(if ($pi) { $pi.Times } else { $null }); Note="Prefetch file of the PREVIOUS Windows: $($pf.Name)" }
    }
    # --- old System event log: drivers installed, logs cleared ---
    $oldSys = "$woRoot\Windows\System32\winevt\Logs\System.evtx"
    if (Test-Path -LiteralPath $oldSys) {
      try {
        foreach ($e7 in @(Get-WinEvent -FilterHashtable @{ Path=$oldSys; Id=7045 } -MaxEvents 400 -ErrorAction Stop)) {
          $m7 = "$($e7.Message)"
          if ($m7 -match "(?i)($byovd)\.sys|dbk(32|64)") { $driverLeads.Add("[previous Windows] service installed $($e7.TimeCreated.ToString('yyyy-MM-dd HH:mm')): $((($m7 -split "`n") | Select-Object -First 3) -join ' ')") }
          $n7 = Find-NameToken $m7
          if ($n7 -and ($genericNames -notcontains $n7)) { $pwCount++; Add-Ev @{ Name=$n7; Src='Event log (previous Windows)'; Path=$null; PIE=$true; Run=$e7.TimeCreated; RunKind='service installed (previous Windows)'; Note="the PREVIOUS Windows installed a service/driver named like it: $((($m7 -split "`n") | Select-Object -First 2) -join ' ')" } }
        }
      } catch {}
      try {
        foreach ($c104 in @(Get-WinEvent -FilterHashtable @{ Path=$oldSys; Id=104 } -MaxEvents 5 -ErrorAction Stop)) { $reinstallFlags++; $reinstallNotes.Add("   [previous Windows] An event log was CLEARED on $($c104.TimeCreated.ToString('yyyy-MM-dd HH:mm')) before the reinstall.") }
      } catch {}
    }
    $reinstallNotes.Add("   Previous Windows read: $pwCount record(s) matched a known name" + $(if ($prevInstall) { "; it was installed $($prevInstall.ToString('yyyy-MM-dd'))" } else { '' }) + $(if ($prevReplaced) { " and replaced around $($prevReplaced.ToString('yyyy-MM-dd'))." } else { '.' }))
  }
}
# ---------- 6b. Old Windows installs read WITHOUT admin (v3.2) ----------
# Old registry files (run history, BAM, ShimCache, Amcache, installed programs) are read straight from their FILES with a small built-in
# reader, so nothing is loaded into Windows and no admin is needed. It can only open files this account is allowed to open: your own old
# profile usually is; the protected system files of Windows.old usually are not (those still need the admin edition).
# Also covers Windows.old.000 style folders and a second Windows (or old user folders) on other drives.
$offSrc = @'
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;

// Read-only reader for Windows registry hive files (regf format). Needs no admin rights and does not load the hive into Windows:
// it only reads the file, so it works on hives of an OLD Windows install as long as the file itself may be opened.
public class JhOffKey
{
    public string Name;
    internal JhOffHive H;
    internal long Abs;      // absolute file offset of this key's cell
    internal byte[] Nk;     // cell data

    public JhOffKey OpenSubKey(string path)
    {
        try
        {
            JhOffKey cur = this;
            string[] parts = path.Split(new char[] { '\\' }, StringSplitOptions.RemoveEmptyEntries);
            for (int i = 0; i < parts.Length; i++)
            {
                JhOffKey next = null;
                List<JhOffKey> kids = cur.Children();
                for (int j = 0; j < kids.Count; j++)
                {
                    if (string.Equals(kids[j].Name, parts[i], StringComparison.OrdinalIgnoreCase)) { next = kids[j]; break; }
                }
                if (next == null) return null;
                cur = next;
            }
            return cur;
        }
        catch (Exception) { return null; }
    }

    public string[] GetSubKeyNames()
    {
        try
        {
            List<JhOffKey> kids = Children();
            string[] r = new string[kids.Count];
            for (int i = 0; i < r.Length; i++) r[i] = kids[i].Name;
            return r;
        }
        catch (Exception) { return new string[0]; }
    }

    public JhOffKey[] GetSubKeys()
    {
        try { return Children().ToArray(); } catch (Exception) { return new JhOffKey[0]; }
    }

    public string[] GetValueNames()
    {
        try
        {
            List<string> names = new List<string>();
            List<byte[]> vks = ValueCells();
            for (int i = 0; i < vks.Count; i++) names.Add(JhOffHive.VkName(vks[i]));
            return names.ToArray();
        }
        catch (Exception) { return new string[0]; }
    }

    public object GetValue(string name)
    {
        try
        {
            List<byte[]> vks = ValueCells();
            for (int i = 0; i < vks.Count; i++)
            {
                if (string.Equals(JhOffHive.VkName(vks[i]), name, StringComparison.OrdinalIgnoreCase)) return H.ReadValue(vks[i]);
            }
            return null;
        }
        catch (Exception) { return null; }
    }

    List<JhOffKey> Children()
    {
        List<JhOffKey> res = new List<JhOffKey>();
        uint count = BitConverter.ToUInt32(Nk, 0x14);
        int listOff = BitConverter.ToInt32(Nk, 0x1C);
        if (count == 0 || listOff == -1) return res;
        List<int> offs = new List<int>();
        H.CollectSubkeyOffsets(listOff, offs, 0);
        for (int i = 0; i < offs.Count; i++)
        {
            if (JhOffHive.Expired()) break;
            JhOffKey k = H.MakeKey(JhOffHive.Base + (long)offs[i]);
            if (k != null) res.Add(k);
        }
        return res;
    }

    List<byte[]> ValueCells()
    {
        List<byte[]> res = new List<byte[]>();
        uint count = BitConverter.ToUInt32(Nk, 0x24);
        int listOff = BitConverter.ToInt32(Nk, 0x28);
        if (count == 0 || listOff == -1 || count > 100000) return res;
        byte[] vl = H.Cell(JhOffHive.Base + (long)listOff);
        if (vl == null) return res;
        for (int i = 0; i < count && (i * 4 + 4) <= vl.Length; i++)
        {
            int vo = BitConverter.ToInt32(vl, i * 4);
            byte[] vk = H.Cell(JhOffHive.Base + (long)vo);
            if (vk == null || vk.Length < 0x14 || vk[0] != (byte)'v' || vk[1] != (byte)'k') continue;
            res.Add(vk);
        }
        return res;
    }
}

public class JhOffHive : IDisposable
{
    internal const long Base = 0x1000;
    public static DateTime Deadline = DateTime.MaxValue;
    FileStream fs;
    public JhOffKey Root;

    internal static bool Expired() { return DateTime.UtcNow > Deadline; }

    public static JhOffHive Open(string path)
    {
        JhOffHive h = null;
        try
        {
            h = new JhOffHive();
            h.fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
            if (h.fs.Length < 0x2000) { h.Dispose(); return null; }
            byte[] hdr = h.ReadAt(0, 0x30);
            if (hdr == null || hdr[0] != (byte)'r' || hdr[1] != (byte)'e' || hdr[2] != (byte)'g' || hdr[3] != (byte)'f') { h.Dispose(); return null; }
            int rootOff = BitConverter.ToInt32(hdr, 0x24);
            h.Root = h.MakeKey(Base + (long)rootOff);
            if (h.Root == null) { h.Dispose(); return null; }
            return h;
        }
        catch (Exception)
        {
            if (h != null) h.Dispose();
            return null;
        }
    }

    public void Dispose()
    {
        try { if (fs != null) { fs.Close(); fs = null; } } catch (Exception) { }
    }

    byte[] ReadAt(long off, int len)
    {
        if (fs == null || off < 0 || len < 0 || off + len > fs.Length) return null;
        byte[] b = new byte[len];
        fs.Seek(off, SeekOrigin.Begin);
        int got = 0;
        while (got < len)
        {
            int n = fs.Read(b, got, len - got);
            if (n <= 0) return null;
            got += n;
        }
        return b;
    }

    // returns the data of a cell (without its 4-byte size field)
    internal byte[] Cell(long abs)
    {
        byte[] sz = ReadAt(abs, 4);
        if (sz == null) return null;
        int size = BitConverter.ToInt32(sz, 0);
        int len = size < 0 ? -size : size;
        if (len < 8 || len > 0x1000000) return null;
        return ReadAt(abs + 4, len - 4);
    }

    internal JhOffKey MakeKey(long abs)
    {
        byte[] nk = Cell(abs);
        if (nk == null || nk.Length < 0x4C || nk[0] != (byte)'n' || nk[1] != (byte)'k') return null;
        int flags = BitConverter.ToUInt16(nk, 2);
        int nameLen = BitConverter.ToUInt16(nk, 0x48);
        if (0x4C + nameLen > nk.Length) return null;
        JhOffKey k = new JhOffKey();
        k.H = this;
        k.Abs = abs;
        k.Nk = nk;
        k.Name = ((flags & 0x20) != 0) ? Encoding.GetEncoding(28591).GetString(nk, 0x4C, nameLen) : Encoding.Unicode.GetString(nk, 0x4C, nameLen);
        return k;
    }

    internal void CollectSubkeyOffsets(int relOff, List<int> outList, int depth)
    {
        if (depth > 4) return;
        byte[] l = Cell(Base + (long)relOff);
        if (l == null || l.Length < 4) return;
        string sig = ((char)l[0]).ToString() + ((char)l[1]).ToString();
        int count = BitConverter.ToUInt16(l, 2);
        if (sig == "lf" || sig == "lh")
        {
            for (int i = 0; i < count && (4 + i * 8 + 4) <= l.Length; i++) outList.Add(BitConverter.ToInt32(l, 4 + i * 8));
        }
        else if (sig == "li")
        {
            for (int i = 0; i < count && (4 + i * 4 + 4) <= l.Length; i++) outList.Add(BitConverter.ToInt32(l, 4 + i * 4));
        }
        else if (sig == "ri")
        {
            for (int i = 0; i < count && (4 + i * 4 + 4) <= l.Length; i++) CollectSubkeyOffsets(BitConverter.ToInt32(l, 4 + i * 4), outList, depth + 1);
        }
    }

    internal static string VkName(byte[] vk)
    {
        int nameLen = BitConverter.ToUInt16(vk, 2);
        int flags = BitConverter.ToUInt16(vk, 0x10);
        if (nameLen == 0) return "";
        if (0x14 + nameLen > vk.Length) return "";
        return ((flags & 1) != 0) ? Encoding.GetEncoding(28591).GetString(vk, 0x14, nameLen) : Encoding.Unicode.GetString(vk, 0x14, nameLen);
    }

    internal object ReadValue(byte[] vk)
    {
        uint dataLen = BitConverter.ToUInt32(vk, 4);
        int type = BitConverter.ToInt32(vk, 12);
        bool inline = (dataLen & 0x80000000u) != 0;
        int len = (int)(dataLen & 0x7FFFFFFFu);
        byte[] data;
        if (inline)
        {
            if (len > 4) len = 4;
            data = new byte[len];
            Array.Copy(vk, 8, data, 0, len);
        }
        else if (len == 0)
        {
            data = new byte[0];
        }
        else
        {
            if (len > 0x2000000) return null;
            int dOff = BitConverter.ToInt32(vk, 8);
            byte[] c = Cell(Base + (long)dOff);
            if (c == null) return null;
            if (len > 16344 && c.Length >= 8 && c[0] == (byte)'d' && c[1] == (byte)'b')
            {
                int segCount = BitConverter.ToUInt16(c, 2);
                int segListOff = BitConverter.ToInt32(c, 4);
                byte[] segList = Cell(Base + (long)segListOff);
                if (segList == null) return null;
                data = new byte[len];
                int pos = 0;
                for (int i = 0; i < segCount && pos < len && (i * 4 + 4) <= segList.Length; i++)
                {
                    byte[] seg = Cell(Base + (long)BitConverter.ToInt32(segList, i * 4));
                    if (seg == null) return null;
                    int take = Math.Min(Math.Min(16344, seg.Length), len - pos);
                    Array.Copy(seg, 0, data, pos, take);
                    pos += take;
                }
            }
            else
            {
                if (c.Length < len) len = c.Length;
                data = new byte[len];
                Array.Copy(c, 0, data, 0, len);
            }
        }
        if (type == 1 || type == 2) return Encoding.Unicode.GetString(data).TrimEnd('\0');
        if (type == 4 && data.Length >= 4) return BitConverter.ToInt32(data, 0);
        if (type == 11 && data.Length >= 8) return BitConverter.ToInt64(data, 0);
        return data;
    }
}
