      if ($n) { Add-Ev @{ Name=$n; Src='BAM'; Path=$r.Path; Unm=$r.Unm; PIE=$true; Run=$t; RunKind='last run (BAM)' } }
    }
  }
}

if ($doExternal) { Set-Stage 'Checking USB device history' }
# ---------- 4. USB device history (External / Both) ----------
$usb = @{}
if ($doExternal) {
