                             if ($dlg.ShowDialog($script:rf) -eq 'OK') { [IO.File]::WriteAllText($dlg.FileName, ($text -join "`r`n")) } } catch {} })
    $bCopy = & $mkb 'Copy' 60;          $bCopy.Add_Click({ try { [Windows.Forms.Clipboard]::SetText(($text -join "`r`n")); $this.Text = 'Copied' } catch {} })
    $bAgain = $null
