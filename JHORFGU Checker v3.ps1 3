if ($sumRows.Count -gt 0) {
  $out.Add('')
  $out.Add('================ SUMMARY (end of results) ================')
  $out.Add(("{0,-12} {1,-11} {2,-13} {3}" -f 'NAME','ON PC NOW','TIMES OPENED','LAST USED'))
