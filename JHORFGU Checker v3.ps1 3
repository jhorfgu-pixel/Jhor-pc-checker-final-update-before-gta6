      if ($hs) {
        $opened++
        try {
          $selCur = 1; try { $sk = $hs.Root.OpenSubKey('Select'); if ($sk) { $sv = $sk.GetValue('Current'); if ($sv -is [int] -and $sv -gt 0) { $selCur = $sv } } } catch {}
