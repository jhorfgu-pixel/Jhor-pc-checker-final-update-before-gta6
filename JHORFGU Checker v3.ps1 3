foreach ($v in $volMap.Values) { if (($v.DriveType -eq 2 -or $v.DriveType -eq 3) -and $v.Letter -ne $sysLetter) { $kwRoots.Add("$($v.Letter):\") } }
$kwDeadline = (Get-Date).AddSeconds(3); $kwCount = 0
foreach ($kr in $kwRoots) {
