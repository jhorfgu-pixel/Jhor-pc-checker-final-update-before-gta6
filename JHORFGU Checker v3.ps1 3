function Test-Ahk($text, $leaf) {
  $named  = $text -match '(?i)roblox|WINDOWSCLIENT'
  $repeat = $text -match '(?i)\bLoop\b|\bWhile\b|SetTimer'
  $pix    = $text -match '(?i)PixelSearch|PixelGetColor|ImageSearch|Gdip_BitmapFromScreen|Gdip_GetPixel|BitBlt|CreateCompatibleBitmap'
  $mouse  = $text -match '(?i)MouseMove|MouseClickDrag|DllCall[^\r\n]{0,80}(?:mouse_event|SetCursorPos|SendInput)|\bClick\s*,?\s*-?\d+\s*,\s*-?\d+'
  $click  = $text -match '(?i)\bClick\b|MouseClick|ControlClick'
  $keys   = $text -match '(?i)\bSend(?:Input|Event|Play|Raw)?\b|ControlSend|SendMessage|PostMessage'
  if (-not ($repeat -or $pix -or $mouse)) { return $null }
  if (-not ($pix -or $mouse -or $click -or $keys)) { return $null }
  $hay = "$leaf`n$text"
  $sc = @{ aimbot = 0; trigger = 0; autoclick = 0; skill = 0; boost = 0; farm = 0; esp = 0; lag = 0; parry = 0 }
  $why = New-Object System.Collections.Generic.List[string]
  if ($hay -match '(?i)aim\s*-?bot|aim\s*assist|aim\s*lock|cam\s*lock|silent\s*aim|target\s*lock|lock\s*-?on|\baim\b|snap\s*to|head\s*shot|\btrack(?:er|ing)?\b|colou?r\s*-?bot|pixel\s*-?bot|hit\s*-?box|resolver|anti\s*-?aim|spin\s*-?bot') { $sc.aimbot += 4; $why.Add('aim / lock-on wording') }
  if ($pix -and $mouse) { $sc.aimbot += 3; $why.Add('finds a color/image on screen and moves the mouse to it') }
  if ($pix -and $mouse -and $text -match '(?i)\bfov\b|smooth(?:ing|ness)?|\bradius\b|sensitivity') { $sc.aimbot += 2; $why.Add('FOV / smoothing settings') }
  if ($pix -and $mouse -and $text -match '(?i)ShadeVariation|tolerance|0x[0-9a-f]{6}\b') { $sc.aimbot += 1; $why.Add('color tolerance / target color') }
  if ($pix -and $mouse -and $text -match '(?i)GetKeyState\s*\(\s*["'']?(?:RButton|LButton|XButton[12]|Shift|Alt|Ctrl)|\bRButton\b[^\r\n]{0,40}::|\bXButton[12]\b[^\r\n]{0,40}::') { $sc.aimbot += 1; $why.Add('only active while a mouse button / key is held') }
  if ($pix -and $text -match '(?i)DllCall[^\r\n]{0,80}mouse_event') { $sc.aimbot += 1; $why.Add('moves the mouse with raw mouse_event') }
  if ($pix -and $mouse -and $hay -match '(?i)rivals|arsenal|phantom\s*forces|bad\s*business|criminality|da\s*hood|counter\s*blox|big\s*paintball|\bdh\b') { $sc.aimbot += 1; $why.Add('names a Roblox shooter game') }
  if ($hay -match '(?i)auto\s*-?parry|\bparry\b|auto\s*-?block|perfect\s*-?block|deflect|blade\s*-?ball') { $sc.parry += 4; $why.Add('auto-parry / auto-block wording') }
  if ($pix -and $keys -and -not $mouse) { $sc.parry += 3; $why.Add('presses a key when something shows up on screen') }
  if ($hay -match '(?i)trigger\s*-?bot|auto\s*-?shoot|auto\s*-?fire|rapid\s*-?fire') { $sc.trigger += 4; $why.Add('triggerbot wording') }
  if ($pix -and $click -and -not $mouse) { $sc.trigger += 3; $why.Add('clicks when a color/image appears on screen') }
  if ($hay -match '(?i)auto\s*-?click|clicker|\bcps\b') { $sc.autoclick += 4; $why.Add('auto-click wording') }
  if ($click -and $repeat -and -not $pix) { $sc.autoclick += 2; $why.Add('repeats clicks in a loop') }
  if ($hay -match '(?i)skill|abilit(?:y|ies)|combo|\bspam|\bcast\b|\bult(?:imate)?\b|move\s*\d|\bm1\b|auto\s*-?(?:use|skill|move|combat|attack)|rotation') { $sc.skill += 3; $why.Add('skill / combo wording') }
  if ($keys -and $repeat) { $sc.skill += 2; $why.Add('sends keys repeatedly') }
  if ($hay -match '(?i)boost|dash|speed|b-?hop|glitch|\bfly\b|no\s*-?clip|teleport|\btp\b|slide|sprint|\brush') { $sc.boost += 3; $why.Add('boost / dash / rush / movement wording') }
  if ($hay -match '(?i)farm|fishing|\bfish\b|grind|auto\s*-?(?:quest|collect|loot)|anti\s*-?afk|\bafk\b|\bidle\b') { $sc.farm += 4; $why.Add('farm / fishing / AFK wording') }
  if ($hay -match '(?i)\besp\b|wall\s*-?hack|radar|chams') { $sc.esp += 3; $why.Add('ESP / radar wording') }
  if ($hay -match '(?i)lag\s*-?switch|desync|fake\s*lag') { $sc.lag += 4; $why.Add('lag switch / desync wording') }
  if (-not $named) {
    # never mentions Roblox: only reported when it is clearly an aimbot / triggerbot (screen search + mouse + aim wording or FOV / smoothing)
    if (-not ($pix -and ($mouse -or $click) -and ($sc.aimbot -ge 6 -or $sc.trigger -ge 4))) { return $null }
    $why.Add('does not name Roblox (it could be aiming in any game)')
  }
  $best = $sc.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 1
  $key = if ($best.Value -ge 3) { $best.Key } else { 'generic' }
  $fn = New-Object System.Collections.Generic.List[string]
  if ($pix) { $fn.Add('screen search') }; if ($mouse) { $fn.Add('mouse control') }; if ($click) { $fn.Add('clicking') }; if ($keys) { $fn.Add('key sending') }; if ($repeat) { $fn.Add('loop/timer') }
  [pscustomobject]@{ Key = $key; Why = ((@($why | Select-Object -Unique) + @('uses: ' + ($fn -join ', '))) -join '; ') }
}
