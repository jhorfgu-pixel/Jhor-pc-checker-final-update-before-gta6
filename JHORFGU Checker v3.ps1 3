if ($safeSeen.Count -gt 0) { $out.Add("Ignored as clip/capture software (Medal, OBS, GeForce Experience and similar): $((@($safeSeen | Select-Object -Unique)) -join ', ')") }
if ($otherProfiles.Count -gt 0) {
